<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snipping.WinUI.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CaptureOverlay">

    <Grid x:Name="RootGrid"
          PointerPressed="RootGrid_OnPointerPressed"
          PointerMoved="RootGrid_OnPointerMoved"
          PointerReleased="RootGrid_OnPointerReleased"
          KeyDown="RootGrid_OnKeyDown"
          IsTabStop="True">
        <Image x:Name="BackdropImage" Stretch="Fill"/>
        <Rectangle Fill="#66000000"/>
        <Canvas>
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Stroke="#FF00AEEF"
                       StrokeThickness="2"
                       Fill="#2200AEEF"/>
            <Border x:Name="SizeBadge" Visibility="Collapsed"
                    Background="#CC1C1C1E" CornerRadius="4" Padding="10,4">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
            </Border>

            <!-- Quick-action toolbar — shown after a valid selection is drawn -->
            <Border x:Name="QuickBar" Visibility="Collapsed"
                    Background="#F0232323" CornerRadius="8" Padding="5,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="QbEdit"   Tag="edit"   Click="Qb_Click"
                            ToolTipService.ToolTip="编辑"
                            Width="34" Height="34" Padding="0" CornerRadius="4">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;" FontSize="14"
                                  Foreground="White"/>
                    </Button>
                    <Button x:Name="QbCopy"   Tag="copy"   Click="Qb_Click"
                            ToolTipService.ToolTip="复制到剪贴板"
                            Width="34" Height="34" Padding="0" CornerRadius="4">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="14"
                                  Foreground="White"/>
                    </Button>
                    <Button x:Name="QbSave"   Tag="save"   Click="Qb_Click"
                            ToolTipService.ToolTip="保存到文件"
                            Width="34" Height="34" Padding="0" CornerRadius="4">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="14"
                                  Foreground="White"/>
                    </Button>
                    <Button x:Name="QbPin"    Tag="pin"    Click="Qb_Click"
                            ToolTipService.ToolTip="置顶贴图"
                            Width="34" Height="34" Padding="0" CornerRadius="4">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE718;" FontSize="14"
                                  Foreground="White"/>
                    </Button>
                    <Rectangle Width="1" Height="20" VerticalAlignment="Center"
                               Fill="#44FFFFFF" Margin="2,0"/>
                    <Button x:Name="QbCancel" Tag="cancel" Click="Qb_Click"
                            ToolTipService.ToolTip="取消 (Esc)"
                            Width="34" Height="34" Padding="0" CornerRadius="4">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14"
                                  Foreground="White"/>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
        <TextBlock x:Name="HintText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,0,0,80" Foreground="White" FontSize="14"
                   Opacity="0.85" Text="拖动选择截图区域  •  Esc 取消"/>
    </Grid>
</Window>
