<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snipping.WinUI.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CaptureOverlay">

    <Grid x:Name="RootGrid"
          PointerPressed="RootGrid_OnPointerPressed"
          PointerMoved="RootGrid_OnPointerMoved"
          PointerReleased="RootGrid_OnPointerReleased"
          KeyDown="RootGrid_OnKeyDown"
          IsTabStop="True">
        <Image x:Name="BackdropImage" Stretch="Fill"/>

        <Canvas x:Name="OverlayCanvasHost">
            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Stroke="#FF00AEEF"
                       StrokeThickness="2"
                       Fill="Transparent"/>

            <Border x:Name="SizeBadge" Visibility="Collapsed"
                    Background="#CC1C1C1E" CornerRadius="4" Padding="10,4">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
            </Border>

            <Border x:Name="InlineEditorHost"
                    Visibility="Collapsed"
                    BorderThickness="1"
                    BorderBrush="#66FFFFFF"
                    Background="#FF202020">
                <Grid x:Name="InlineEditorSurface">
                    <Image x:Name="InlineBaseImage" Stretch="None"/>
                    <Canvas x:Name="InlineDrawCanvas"
                            Background="Transparent"
                            PointerPressed="InlineDrawCanvas_OnPointerPressed"
                            PointerMoved="InlineDrawCanvas_OnPointerMoved"
                            PointerReleased="InlineDrawCanvas_OnPointerReleased"
                            PointerWheelChanged="InlineDrawCanvas_OnPointerWheelChanged"/>
                </Grid>
            </Border>

            <Thumb x:Name="ResizeThumbTL" Tag="nw" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>
            <Thumb x:Name="ResizeThumbTC" Tag="n" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>
            <Thumb x:Name="ResizeThumbTR" Tag="ne" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>
            <Thumb x:Name="ResizeThumbRC" Tag="e" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>
            <Thumb x:Name="ResizeThumbBR" Tag="se" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>
            <Thumb x:Name="ResizeThumbBC" Tag="s" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>
            <Thumb x:Name="ResizeThumbBL" Tag="sw" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>
            <Thumb x:Name="ResizeThumbLC" Tag="w" Visibility="Collapsed" Width="12" Height="12" Background="#FF00AEEF" DragDelta="ResizeThumb_OnDragDelta"/>

            <Border x:Name="InlineToolbar"
                    Visibility="Collapsed"
                    Background="#F0232323"
                    CornerRadius="8"
                    Padding="8,6">
                <StackPanel Orientation="Vertical" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToolRect" IsChecked="True" Click="ToolBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="矩形 (R)">
                            <TextBlock Text="&#x25A1;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolEllipse" Click="ToolBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="椭圆 (E)">
                            <TextBlock Text="&#x25CB;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolArrow" Click="ToolBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="箭头 (A)">
                            <TextBlock Text="&#x2197;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolPen" Click="ToolBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="画笔 (P)">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;" FontSize="14" Foreground="White"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolHighlight" Click="ToolBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="高亮 (H)">
                            <TextBlock Text="&#x2550;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FFFFD60A"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolMosaic" Click="ToolBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="马赛克笔刷 (M)">
                            <TextBlock Text="&#x2592;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolText" Click="ToolBtn_Click" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="文字 (T)">
                            <TextBlock Text="T" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                        </ToggleButton>

                        <Rectangle Width="1" Height="20" VerticalAlignment="Center" Fill="#44FFFFFF" Margin="2,0"/>

                        <Button x:Name="SwatchRed" Tag="#FFE5453A" Click="Swatch_Click" Width="20" Height="20" Padding="0" CornerRadius="10" Background="#FFE5453A" BorderThickness="2" BorderBrush="White"/>
                        <Button x:Name="SwatchYellow" Tag="#FFFFD60A" Click="Swatch_Click" Width="20" Height="20" Padding="0" CornerRadius="10" Background="#FFFFD60A" BorderThickness="0" BorderBrush="White"/>
                        <Button x:Name="SwatchBlue" Tag="#FF0A84FF" Click="Swatch_Click" Width="20" Height="20" Padding="0" CornerRadius="10" Background="#FF0A84FF" BorderThickness="0" BorderBrush="White"/>
                        <Button x:Name="SwatchGreen" Tag="#FF30D158" Click="Swatch_Click" Width="20" Height="20" Padding="0" CornerRadius="10" Background="#FF30D158" BorderThickness="0" BorderBrush="White"/>
                        <Button x:Name="SwatchWhite" Tag="#FFFFFFFF" Click="Swatch_Click" Width="20" Height="20" Padding="0" CornerRadius="10" Background="#FFFFFFFF" BorderThickness="0" BorderBrush="#88000000"/>
                        <Button x:Name="SwatchBlack" Tag="#FF1C1C1E" Click="Swatch_Click" Width="20" Height="20" Padding="0" CornerRadius="10" Background="#FF1C1C1E" BorderThickness="0" BorderBrush="White"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="InlineUndoButton" Click="InlineUndoButton_OnClick" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="撤销 (Ctrl+Z)">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7A7;" FontSize="14" Foreground="White"/>
                        </Button>
                        <Button x:Name="InlineCopyButton" Click="InlineCopyButton_OnClick" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="复制 (Ctrl+C)">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="14" Foreground="White"/>
                        </Button>
                        <Button x:Name="InlineSaveButton" Click="InlineSaveButton_OnClick" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="保存 (Ctrl+S)">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="14" Foreground="White"/>
                        </Button>
                        <Button x:Name="InlinePinButton" Click="InlinePinButton_OnClick" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="置顶">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE718;" FontSize="14" Foreground="White"/>
                        </Button>
                        <Button x:Name="InlineDoneButton" Click="InlineDoneButton_OnClick" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="完成 (Enter)">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="14" Foreground="#FF3AD900"/>
                        </Button>
                        <Button x:Name="InlineCloseButton" Click="InlineCloseButton_OnClick" Width="34" Height="34" Padding="0" CornerRadius="4" ToolTipService.ToolTip="关闭 (Esc)">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14" Foreground="#FFFF5F57"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

        <TextBlock x:Name="HintText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,0,0,80" Foreground="White" FontSize="14"
                   Opacity="0.85" Text="拖动选择截图区域  •  Esc 取消"/>
    </Grid>
</Window>
