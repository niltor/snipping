<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snipping.WinUI.CaptureEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" KeyDown="RootGrid_OnKeyDown" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,7"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">

                    <ToggleButton x:Name="ToolRect" IsChecked="True"
                                  Style="{StaticResource ToolBtnStyle}" Click="ToolBtn_Click"
                                  ToolTipService.ToolTip="Rectangle  (R)">
                        <TextBlock Text="&#x25A1;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolEllipse"
                                  Style="{StaticResource ToolBtnStyle}" Click="ToolBtn_Click"
                                  ToolTipService.ToolTip="Ellipse  (E)">
                        <TextBlock Text="&#x25CB;" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolArrow"
                                  Style="{StaticResource ToolBtnStyle}" Click="ToolBtn_Click"
                                  ToolTipService.ToolTip="Arrow  (A)">
                        <TextBlock Text="&#x2197;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolPen"
                                  Style="{StaticResource ToolBtnStyle}" Click="ToolBtn_Click"
                                  ToolTipService.ToolTip="Pen  (P)">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ToolText"
                                  Style="{StaticResource ToolBtnStyle}" Click="ToolBtn_Click"
                                  ToolTipService.ToolTip="Text  (T)">
                        <TextBlock Text="T" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="24" VerticalAlignment="Center" Margin="6,0"
                               Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>

                    <Button x:Name="SwatchRed"    Tag="#FFE5453A" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FFE5453A" BorderThickness="2" BorderBrush="White" ToolTipService.ToolTip="Red"/>
                    <Button x:Name="SwatchOrange" Tag="#FFFF9F0A" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FFFF9F0A" BorderThickness="0" BorderBrush="White" ToolTipService.ToolTip="Orange"/>
                    <Button x:Name="SwatchYellow" Tag="#FFFFD60A" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FFFFD60A" BorderThickness="0" BorderBrush="White" ToolTipService.ToolTip="Yellow"/>
                    <Button x:Name="SwatchGreen"  Tag="#FF30D158" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FF30D158" BorderThickness="0" BorderBrush="White" ToolTipService.ToolTip="Green"/>
                    <Button x:Name="SwatchBlue"   Tag="#FF0A84FF" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FF0A84FF" BorderThickness="0" BorderBrush="White" ToolTipService.ToolTip="Blue"/>
                    <Button x:Name="SwatchPurple" Tag="#FFBF5AF2" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FFBF5AF2" BorderThickness="0" BorderBrush="White" ToolTipService.ToolTip="Purple"/>
                    <Button x:Name="SwatchWhite"  Tag="#FFFFFFFF" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FFFFFFFF" BorderThickness="0" BorderBrush="#88000000" ToolTipService.ToolTip="White"/>
                    <Button x:Name="SwatchBlack"  Tag="#FF1C1C1E" Click="Swatch_Click" Width="22" Height="22" Padding="0" CornerRadius="11" Background="#FF1C1C1E" BorderThickness="0" BorderBrush="White" ToolTipService.ToolTip="Black"/>

                    <Rectangle Width="1" Height="24" VerticalAlignment="Center" Margin="6,0"
                               Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>

                    <ToggleButton x:Name="ThickThin"
                                  Style="{StaticResource ThickBtnStyle}" IsChecked="False"
                                  Click="ThickBtn_Click" Tag="2" ToolTipService.ToolTip="Thin">
                        <Rectangle Width="16" Height="1.5" VerticalAlignment="Center"
                                   Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ThickMed"
                                  Style="{StaticResource ThickBtnStyle}" IsChecked="True"
                                  Click="ThickBtn_Click" Tag="4" ToolTipService.ToolTip="Medium">
                        <Rectangle Width="16" Height="3.5" VerticalAlignment="Center"
                                   Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ThickBold"
                                  Style="{StaticResource ThickBtnStyle}" IsChecked="False"
                                  Click="ThickBtn_Click" Tag="8" ToolTipService.ToolTip="Bold">
                        <Rectangle Width="16" Height="7" VerticalAlignment="Center"
                                   Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="24" VerticalAlignment="Center" Margin="6,0"
                               Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>

                    <Button x:Name="UndoButton" Click="UndoButton_OnClick"
                            Width="36" Height="36" Padding="0" CornerRadius="4"
                            ToolTipService.ToolTip="Undo  (Ctrl+Z)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="Z"/>
                        </Button.KeyboardAccelerators>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7A7;" FontSize="14"/>
                    </Button>

                    <Rectangle Width="10"/>

                    <Button x:Name="CopyButton" Click="CopyButton_OnClick"
                            Style="{StaticResource ActionBtnStyle}"
                            ToolTipService.ToolTip="Copy to clipboard  (Ctrl+Shift+C)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="C"/>
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="13"/>
                            <TextBlock x:Name="CopyLabel" Text="&#x590D;&#x5236;" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveButton" Click="SaveButton_OnClick"
                            Style="{StaticResource ActionBtnStyle}"
                            ToolTipService.ToolTip="Save  (Ctrl+S)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S"/>
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="13"/>
                            <TextBlock x:Name="SaveLabel" Text="&#x4FDD;&#x5B58;" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PinButton" Click="PinButton_OnClick"
                            Style="{StaticResource ActionBtnStyle}"
                            ToolTipService.ToolTip="Pin on screen">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE718;" FontSize="13"/>
                            <TextBlock x:Name="PinLabel" Text="&#x8D34;&#x56FE;" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DoneButton" Click="DoneButton_OnClick"
                            Style="{StaticResource PrimaryBtnStyle}"
                            ToolTipService.ToolTip="Copy and Save  (Enter)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter"/>
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="13"/>
                            <TextBlock x:Name="DoneLabel" Text="&#x5B8C;&#x6210;" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Background="#FF3A3A3A">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <Grid x:Name="EditorSurface" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="BaseImage" Stretch="None"/>
                        <Canvas x:Name="OverlayCanvas"
                                Background="Transparent"
                                PointerPressed="OverlayCanvas_OnPointerPressed"
                                PointerMoved="OverlayCanvas_OnPointerMoved"
                                PointerReleased="OverlayCanvas_OnPointerReleased"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border x:Name="ToastBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,20" Background="#CC1C1C1E" CornerRadius="6" Padding="16,8">
                <TextBlock x:Name="ToastBarText" Foreground="White" FontSize="13"/>
            </Border>
        </Grid>
    </Grid>
</Window>


