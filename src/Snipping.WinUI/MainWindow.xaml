<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snipping.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Snipping Settings">

    <Grid Padding="24" MinWidth="760" MinHeight="460" Loaded="MainWindow_OnLoaded"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Snipping"
                       FontSize="13"
                       Opacity="0.7" />
            <TextBlock Text="设置"
                       FontSize="28"
                       FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷键与保存"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="HotkeyLabel" VerticalAlignment="Center" Text="全局截图快捷键" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyTextBox" PlaceholderText="Ctrl+Shift+S" KeyDown="ShortcutBox_KeyDown" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" x:Name="HotkeyHintText" VerticalAlignment="Center" Opacity="0.75" Text="点击输入框后直接按组合键" />

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="PinShortcutLabel" VerticalAlignment="Center" Text="置顶贴图快捷键" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PinShortcutTextBox" PlaceholderText="Ctrl+T" KeyDown="ShortcutBox_KeyDown" />

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SaveDirectoryLabel" VerticalAlignment="Center" Text="保存目录" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SaveDirectoryTextBox" />
                            <Button Grid.Row="2" Grid.Column="2" x:Name="BrowseButton" Margin="0" Content="浏览" Click="BrowseButton_OnClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="界面与语言"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="ThemeLabel" VerticalAlignment="Center" Text="主题" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="18">
                                <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" IsChecked="True" Checked="ThemeRadio_OnChecked"/>
                                <RadioButton x:Name="ThemeLightRadio" Content="浅色" Checked="ThemeRadio_OnChecked"/>
                                <RadioButton x:Name="ThemeDarkRadio" Content="深色" Checked="ThemeRadio_OnChecked"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LanguageLabel" VerticalAlignment="Center" Text="语言" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LanguageCombo" Width="220" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_OnSelectionChanged">
                                <ComboBoxItem Content="中文 (简体)" Tag="zh-CN" IsSelected="True"/>
                                <ComboBoxItem Content="English" Tag="en-US"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="PinTransparencyLabel" VerticalAlignment="Center" Text="贴图透明度" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <NumberBox x:Name="PinTransparencyNumberBox" Width="220" Minimum="0" Maximum="90" SmallChange="1" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Text="%" VerticalAlignment="Center" Opacity="0.75"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="保存" Click="SaveButton_OnClick" Style="{StaticResource AccentButtonStyle}" MinWidth="92" />
            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_OnClick" MinWidth="92" />
        </StackPanel>
    </Grid>
</Window>
