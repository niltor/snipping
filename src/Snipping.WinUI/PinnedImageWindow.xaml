<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snipping.WinUI.PinnedImageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pinned Image">

    <!-- Image fills the entire borderless window; drag is handled by pointer event -->
    <Grid x:Name="RootGrid"
                    Background="Black"
          KeyDown="RootGrid_OnKeyDown"
          PointerPressed="RootGrid_OnPointerPressed"
                    PointerMoved="RootGrid_OnPointerMoved"
                    PointerReleased="RootGrid_OnPointerReleased"
          IsTabStop="True">
                <Image x:Name="PinImage" Stretch="Fill"/>
    </Grid>
</Window>
